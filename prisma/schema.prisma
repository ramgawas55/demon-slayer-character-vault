generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Image {
  id          String   @id @default(cuid())
  url         String
  uploadedBy  String   // "user" | "admin"
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
